{
  "name": "tutytv-modernization",
  "version": "0.1.0",
  "private": true,
  "description": "Incremental modular architecture for TutyTV (TypeScript + Vite)",
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "dev:web": "pnpm run dev",
    "build:web": "node scripts/build-web.mjs && vite build --config vite.core.web.config.ts",
    "start:web": "node source/web/server.js --app-dir=dist/web --no-open",
    "start": "node source/web/server.js",
    "build:webos": "vite build --config vite.webos.config.ts",
    "build:core": "vite build --config vite.core.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts vite.core.config.ts vite.core.web.config.ts vite.web.config.ts vite.webos.config.ts vitest.config.ts eslint.config.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "build:ipk": "pnpm run build:core && cd source && ./tools/build-ipk.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
